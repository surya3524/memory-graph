{
  "manifest_version": 3,
  "name": "RJ Advisor Memory Agent",
  "version": "1.0",
  "description": "AI-powered page scanner for Raymond James financial advisors",
  "action": {
    "default_popup": "popup.html",
    "default_width": 420,
    "default_height": 600
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["<all_urls>"]
}
